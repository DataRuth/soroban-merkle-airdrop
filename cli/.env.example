# ── merkle-airdrop CLI — environment variables ──────────────────────────────
#
# Copy this file to .env and fill in the values for your deployment.
# Never commit the .env file — it is listed in .gitignore.
#
# Usage:
#   cp .env.example .env
#   # edit .env with real values
#   pnpm start claim --tree merkle-tree.json --address G...
#
# The CLI loads these automatically via `import 'dotenv/config'` in src/index.ts.
# Any option can also be passed as a CLI flag instead of an env var.
# -----------------------------------------------------------------------------

# ── Stellar secret key ───────────────────────────────────────────────────────
# The secret key (S...) of the account that will sign claim transactions.
# Alternatively pass --secret-key <S...> on the command line.
# Required for: claim
STELLAR_SECRET_KEY=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── Airdrop contract address ─────────────────────────────────────────────────
# The Soroban contract ID (C...) of the deployed soroban-merkle-airdrop contract.
# Alternatively pass --contract-id <C...> on the command line.
# Required for: claim, status
AIRDROP_CONTRACT_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── Network ──────────────────────────────────────────────────────────────────
# Target Stellar network: "testnet" or "mainnet".
# Defaults to "testnet" if omitted.
# Alternatively pass -n / --network <testnet|mainnet> on the command line.
NETWORK=testnet

# ── RPC URL override ─────────────────────────────────────────────────────────
# Override the Soroban RPC endpoint. Leave blank to use the built-in defaults:
#   testnet: https://soroban-testnet.stellar.org
#   mainnet: https://mainnet.sorobanrpc.com
# Alternatively pass --rpc-url <url> on the command line.
# RPC_URL=https://soroban-testnet.stellar.org
