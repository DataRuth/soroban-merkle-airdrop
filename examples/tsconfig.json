{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "@soroban-merkle-airdrop/sdk": ["../sdk/src/index.ts"]
    }
  },
  "include": ["*.ts"],
  "exclude": ["node_modules"]
}
