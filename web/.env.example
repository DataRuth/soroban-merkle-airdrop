# ── soroban-merkle-airdrop Web — environment variables ───────────────────────
#
# Copy this file to .env.local and fill in the values for your deployment.
# Never commit .env.local — it is listed in .gitignore.
#
# Usage:
#   cp .env.example .env.local
#   # edit .env.local with real contract addresses
#   pnpm dev
#
# Variables prefixed with NEXT_PUBLIC_ are embedded at build time and exposed
# to the browser. Do NOT put secrets here.
# -----------------------------------------------------------------------------

# ── Active network (build-time default) ─────────────────────────────────────
# Set to "mainnet" to make the UI default to mainnet on first load.
# Users can still switch networks in the UI at runtime.
# Defaults to "testnet" if omitted.
NEXT_PUBLIC_NETWORK=testnet

# ── Testnet contract ID ───────────────────────────────────────────────────────
# The deployed contract address on Stellar Testnet (C...).
# Used when NEXT_PUBLIC_NETWORK=testnet or when the user switches to testnet.
NEXT_PUBLIC_AIRDROP_CONTRACT_ID_TESTNET=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── Mainnet contract ID ───────────────────────────────────────────────────────
# The deployed contract address on Stellar Mainnet (C...).
# Used when NEXT_PUBLIC_NETWORK=mainnet or when the user switches to mainnet.
NEXT_PUBLIC_AIRDROP_CONTRACT_ID_MAINNET=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── Fallback / generic contract ID ───────────────────────────────────────────
# Used when the network-specific variable above is not set.
# Useful for single-network deployments where you only need one contract address.
NEXT_PUBLIC_AIRDROP_CONTRACT_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── Default Merkle tree URL (optional) ───────────────────────────────────────
# If set, this URL is pre-filled in the claim page's "Load from URL" input.
# The file must be publicly accessible and served with CORS headers.
# Example: a public S3 bucket, GitHub Pages, or Cloudflare R2 URL.
# Leave blank if you want users to paste the JSON or enter the URL manually.
# NEXT_PUBLIC_MERKLE_TREE_URL=https://example.com/merkle-tree.json
